{
  "info": {
    "name": "Lab 3 - Books REST API (Thammala Saketh)",
    "description": "Run the whole collection in order with the Collection Runner. Set baseUrl first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "newBookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 List books with defaults",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"10 books returned\", function () { pm.expect(list).to.be.an(\"array\").with.lengthOf(10); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": []
        }
      }
    },
    {
      "name": "02 Get one book",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Book 3 is returned\", function () { const b = pm.response.json(); pm.expect(b.id).to.eql(3); pm.expect(b.title).to.eql(\"Introduction to Algorithms\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/3/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "3"
          ],
          "query": []
        }
      }
    },
    {
      "name": "03 Search title: python",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"3 matches, all contain python\", function () { pm.expect(list).to.have.lengthOf(3); list.forEach(b => pm.expect(b.title.toLowerCase()).to.include(\"python\")); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?search_q=python",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "search_q",
              "value": "python"
            }
          ]
        }
      }
    },
    {
      "name": "04 Search is not case sensitive",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"2 matches\", function () { pm.expect(list).to.have.lengthOf(2); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?search_q=ALGORITHMS",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "search_q",
              "value": "ALGORITHMS"
            }
          ]
        }
      }
    },
    {
      "name": "05 Sort by price, highest first",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"5 books, prices going down\", function () { pm.expect(list).to.have.lengthOf(5); for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].price).to.be.at.least(list[i].price); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?order_by=price&order=DESC&limit=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "5"
            }
          ]
        }
      }
    },
    {
      "name": "06 Sort by title, A to Z",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"Titles in order\", function () { const t = list.map(b => b.title); pm.expect(t).to.eql([...t].sort((a, b) => a.localeCompare(b, \"en\", { sensitivity: \"base\" }))); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?order_by=title&order=ASC",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "order_by",
              "value": "title"
            },
            {
              "key": "order",
              "value": "ASC"
            }
          ]
        }
      }
    },
    {
      "name": "07 Pagination: limit 3, offset 3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"Books 4, 5 and 6\", function () { pm.expect(list.map(b => b.id)).to.eql([4, 5, 6]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?limit=3&offset=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "3"
            }
          ]
        }
      }
    },
    {
      "name": "08 Price range 500 to 700",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"3 books, all within range\", function () { pm.expect(list).to.have.lengthOf(3); list.forEach(b => { pm.expect(b.price).to.be.within(500, 700); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?min_price=500&max_price=700",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "min_price",
              "value": "500"
            },
            {
              "key": "max_price",
              "value": "700"
            }
          ]
        }
      }
    },
    {
      "name": "09 All filters together",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "const list = pm.response.json();",
              "pm.test(\"At most 3, in range, pages going down\", function () { pm.expect(list.length).to.be.at.most(3); list.forEach(b => pm.expect(b.price).to.be.within(500, 1300)); for (let i = 1; i < list.length; i++) pm.expect(list[i - 1].pages).to.be.at.least(list[i].pages); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/?search_q=o&min_price=500&max_price=1300&order_by=pages&order=DESC&limit=3&offset=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "search_q",
              "value": "o"
            },
            {
              "key": "min_price",
              "value": "500"
            },
            {
              "key": "max_price",
              "value": "1300"
            },
            {
              "key": "order_by",
              "value": "pages"
            },
            {
              "key": "order",
              "value": "DESC"
            },
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "1"
            }
          ]
        }
      }
    },
